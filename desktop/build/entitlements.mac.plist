<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What Inroad needs under the hardened runtime, and nothing more:
  - JIT: Chromium and Node compile JavaScript at run time.
  - Library validation off: the server loads the keychain module's native binary, which isn't signed by Apple.
  No camera, microphone, location or contacts. (The app isn't sandboxed; App Store distribution would need that.)
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
