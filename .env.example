# Inroad Environment Configuration Example
# Copy this file to .env.local to configure your local development environment

# --- LLM Provider ---
# Anthropic API key used by the multi-tier agent engine (Opus, Sonnet, Haiku).
# Can also be entered in the app, which keeps it in the system credential store
# (or an encrypted ai-keys.json where there is none); a key saved in the app wins.
# In mock mode (npm run mock:anthropic), any string or unset value is accepted.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Other providers work the same way (see "Choosing your AI provider" in README.md):
# OPENAI_API_KEY, GEMINI_API_KEY, XAI_API_KEY, GROQ_API_KEY, OPENROUTER_API_KEY,
# MISTRAL_API_KEY, DEEPSEEK_API_KEY, TOGETHER_API_KEY, or INROAD_AI_PROVIDER with
# INROAD_AI_MODEL / INROAD_AI_BASE_URL / INROAD_AI_KEY.

# Optional Anthropic API Base URL override (used when running against local mocks)
# ANTHROPIC_BASE_URL=http://127.0.0.1:4010

# OPENAI_API_KEY also paints the photos and illustrations behind Studio graphics (GPT Image) when no
# OpenAI key is saved in Settings. Without either, Studio writes the prompt for you to paste into ChatGPT.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://127.0.0.1:4010/v1

# --- Server & Networking ---
# Port for the Next.js application server (default: 3000)
PORT=3000

# Optional webhook signing secret for outgoing integrations (Zapier, Slack, n8n)
INROAD_SIGNING_SECRET=whsec_your_signing_secret_here

# --- External Enrichment (Optional) ---
# Firecrawl API endpoint and key for Alexandria people data and company web crawls
# FIRECRAWL_API_URL=https://api.firecrawl.dev
# FIRECRAWL_API_KEY=fc-your_key_here

# --- Persistence Override (Optional) ---
# Override the directory for local atomic JSON workspace storage (default: ./.data)
# GTM_DATA_DIR=./.data

# --- Updates (Optional) ---
# Stop this server asking GitHub for a new version by itself (Settings → Updates → Check now still asks)
# INROAD_UPDATE_CHECK=off

# External web search is independent of the AI model (Claude retains built-in search).
# Settings → General → Web search takes precedence. Existing Firecrawl integrations keep working.
# INROAD_SEARCH_PROVIDER=auto
# Choices: auto, off, firecrawl, deepseek, tinyfish, tavily, exa, brave, custom, connected.
# DeepSeek search must be selected explicitly; it reuses DEEPSEEK_API_KEY or the saved model key.
# TINYFISH_API_KEY=
# TAVILY_API_KEY=
# EXA_API_KEY=
# BRAVE_SEARCH_API_KEY=
# Custom search adapter: POST {query, limit} → {results: [{url, title, description}]}.
# INROAD_SEARCH_URL=http://localhost:8080/search
# INROAD_SEARCH_KEY=

# Use an enabled MCP/OpenAPI connection mapped under Research → Connections.
# INROAD_SEARCH_CONNECTION_ID=

# Multiple AI accounts, task models and automatic routing:
# Settings → General → AI connections and task routing (docs/AI-ROUTING.md).
# Gateway keys can be saved separately for each connection or supplied here.
# AI_GATEWAY_API_KEY=
# CLOUDFLARE_API_TOKEN=
# Cloudflare account/gateway IDs and canonical model IDs are configured per connection in Settings.
# Cloudflare account inference requires Account → Workers AI → Read, plus billing/upstream setup.
