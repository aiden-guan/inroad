{
  "name": "inroad",
  "version": "0.2.13",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "build": "next build",
    "start": "node scripts/serve.mjs start",
    "lint": "eslint",
    "dev:mock": "node scripts/serve.mjs dev --mock",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock": "node scripts/mock-anthropic.mjs",
    "tapes:record": "node scripts/live/record-tapes.mjs",
    "smoke:live": "node scripts/live/smoke.mjs",
    "e2e": "playwright test",
    "mock:anthropic": "node scripts/mock-anthropic.mjs",
    "eval:critic": "vitest run --config vitest.eval.config.mts scripts/eval-critic.ts",
    "eval:classify": "vitest run --config vitest.eval.config.mts scripts/eval-classify.ts",
    "desktop:server": "node scripts/desktop/build-server.mjs",
    "desktop:dev": "electron desktop/app",
    "desktop:test": "playwright test -c desktop/playwright.config.ts",
    "desktop:dist": "electron-builder --config desktop/electron-builder.yml --mac --publish never",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@napi-rs/keyring": "2.1.0",
    "@number-flow/react": "^0.6.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@resvg/resvg-js": "^2.6.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.60.0",
    "maplibre-gl": "6.13.0",
    "motion": "^14.4.0",
    "next": "16.4.2",
    "node-html-parser": "^9.0.5",
    "playwright-core": "1.56.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "undici": "7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "44.10.0",
    "electron-builder": "26.17.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.12"
  }
}
